@page
@model AeroLink.Web.Pages.Baggage.CloseModel
@{
    var report = Model.Report;
    var flight = report.Flight;
    ViewData["Title"] = "Close loading " + flight.FlightNumber;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="./Index">Baggage</a></li>
        <li class="breadcrumb-item"><a asp-page="./Flights">Select flight</a></li>
        <li class="breadcrumb-item"><a asp-page="./Status" asp-route-flightId="@flight.FlightId">@flight.FlightNumber status</a></li>
        <li class="breadcrumb-item active" aria-current="page">Close loading</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Close loading &middot; @flight.FlightNumber @flight.Route</h1>
        <p class="text-muted mb-0">Departs @flight.DepartureTimeText &middot; Loading: @flight.StatusText</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="./Status" asp-route-flightId="@flight.FlightId">Back to loading status</a>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert"><strong>Not closed.</strong> @Model.ErrorMessage</div>
}

<div class="row row-cols-2 row-cols-md-5 g-2 mb-4 text-center">
    <div class="col"><div class="card h-100"><div class="card-body py-2">
        <div class="fs-4">@flight.ExpectedBags</div><div class="small text-muted">Expected</div>
    </div></div></div>
    <div class="col"><div class="card h-100"><div class="card-body py-2">
        <div class="fs-4 text-success">@flight.LoadedBags</div><div class="small text-muted">Loaded</div>
    </div></div></div>
    <div class="col"><div class="card h-100"><div class="card-body py-2">
        <div class="fs-4">@flight.ApprovedNotToLoadBags</div><div class="small text-muted">Approved not to load</div>
    </div></div></div>
    <div class="col"><div class="card h-100"><div class="card-body py-2">
        <div class="fs-4 @(flight.OutstandingBags > 0 ? "text-warning-emphasis" : "")">@flight.OutstandingBags</div>
        <div class="small text-muted">Outstanding</div>
    </div></div></div>
    <div class="col"><div class="card h-100"><div class="card-body py-2">
        <div class="fs-4 @(flight.OpenExceptions > 0 ? "text-danger" : "")">@flight.OpenExceptions</div>
        <div class="small text-muted">Open exceptions</div>
    </div></div></div>
</div>

@if (report.IsReadyToClose)
{
    <form method="post" class="card border-success" style="max-width: 640px;">
        <div class="card-body">
            <h2 class="h5 text-success">Ready to close</h2>
            <p>
                All @flight.ExpectedBags expected bags are accounted for
                (@flight.LoadedBags loaded, @flight.ApprovedNotToLoadBags approved not to load) and no exception is open.
            </p>
            <p class="small text-muted">
                Closing loading marks it Completed and produces the final loading summary. After that, no bags can be
                loaded and no exceptions can be changed for this flight.
            </p>
            <input type="hidden" asp-for="FlightId" />
            <button type="submit" class="btn btn-success"
                    onclick="return confirm('Close loading for @flight.FlightNumber? This cannot be undone.');">Close loading</button>
        </div>
    </form>
}
else
{
    <div class="alert alert-warning">
        <strong>Loading cannot be closed yet.</strong>
        <ul class="mb-0 mt-1">
            @foreach (var reason in report.BlockingReasons)
            {
                <li>@reason</li>
            }
        </ul>
    </div>

    <div class="row g-4">
        @if (report.OutstandingBags.Count > 0)
        {
            <div class="col-lg-6">
                <h2 class="h5">Outstanding bags</h2>
                <table class="table table-sm bg-white">
                    <thead class="table-light">
                        <tr><th>Bag tag</th><th>Type</th><th>Needs</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var bag in report.OutstandingBags)
                        {
                            <tr class="@(bag.HasOpenException ? "table-danger" : "")">
                                <td class="font-monospace">@bag.Tag</td>
                                <td>@bag.TypeText</td>
                                <td>@(bag.HasOpenException ? "Supervisor decision" : "Loading or a decision not to load")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a class="btn btn-sm btn-outline-primary" asp-page="./Verify" asp-route-flightId="@flight.FlightId">Go to verify bags</a>
            </div>
        }

        @if (report.OpenExceptions.Count > 0)
        {
            <div class="col-lg-6">
                <h2 class="h5">Open exceptions</h2>
                <table class="table table-sm bg-white">
                    <thead class="table-light">
                        <tr><th>Bag tag</th><th>Problem</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var exception in report.OpenExceptions)
                        {
                            <tr>
                                <td class="font-monospace">@exception.Tag</td>
                                <td>@exception.CategoryText</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-primary" asp-page="./Decide" asp-route-exceptionId="@exception.ExceptionId">Review</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
