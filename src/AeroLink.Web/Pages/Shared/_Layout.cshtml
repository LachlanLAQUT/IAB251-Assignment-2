@using Microsoft.AspNetCore.Http
@{
    var employeeName = Context.Session.GetString(SessionKeys.EmployeeName);
    var role = Context.Session.GetString(SessionKeys.Role);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AeroLink Ground Services</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-aerolink mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-page="/Index">✈ AeroLink</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                        @if (employeeName is not null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Baggage/Index">Baggage</a></li>
                        }
                        @* T1/I1: add module links here once the pages exist. *@
                    </ul>
                    <span class="navbar-text text-white-50">
                        @if (employeeName is not null)
                        {
                            <span>@employeeName (@role)</span>
                            @* T3: add Log out link here. *@
                        }
                        else
                        {
                            <span>Not signed in</span>
                            <a class="btn btn-sm btn-outline-light ms-2" asp-page="/Account/Login">Sign in</a>
                        }
                    </span>
                </div>
            </div>
        </nav>
    </header>

    <main class="container pb-5" role="main">
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted small">
        <div class="container">AeroLink Ground Services &middot; Departure Baggage Loading prototype</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
